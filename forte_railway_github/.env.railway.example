# Paste as environment variables into Railway. NEVER commit actual values.
# --- gateway (API + UI) ---
# The ONLY key you must set. This is the X-API-Key you give the jury.
FORTE_API_KEY=REPLACE_WITH_LONG_RANDOM_PUBLIC_API_KEY
# FORTE_WORKER_KEY is OPTIONAL. Leave it unset for the all-in-one deploy: the worker and the
# /internal routes reuse FORTE_API_KEY. Set a distinct one ONLY if the worker is a separate,
# untrusted service you want isolated from the public key.
# FORTE_WORKER_KEY=
FORTE_STORAGE_DIR=/data
FORTE_SAVE_VIDEOS=0
FORTE_MAX_UPLOAD_MB=150
FORTE_MAX_PENDING=10
FORTE_JOB_TIMEOUT_SEC=295
FORTE_ALLOW_MP4=1

# --- all-in-one CPU worker (same container; see README section 3c) ---
# FORTE_GATEWAY_URL and FORTE_DEVICE are set automatically by start-allinone.sh.
FORTE_DEVICE=cpu
# Detector: OpenVINO model dir (already exported) OR best.onnx.
FORTE_DETECTOR_WEIGHTS=/app/models/best_openvino_model
# Action: ONNX (regenerate with --format onnx) OR the OpenVINO action.xml.
FORTE_ACTION_CHECKPOINT=/app/models/action.onnx
FORTE_ACTION_BACKEND=onnx
FORTE_DETECTOR_IMGSZ=640
FORTE_SAMPLE_FPS=2
FORTE_ACTION_THRESHOLD=0.65
FORTE_ACTION_WINDOW_SEC=4
FORTE_ACTION_STRIDE_SEC=2
FORTE_MAX_DURATION_SEC=180
# FORTE_CPU_THREADS=4   # optional: cap ONNX Runtime threads to your Railway plan's vCPUs
